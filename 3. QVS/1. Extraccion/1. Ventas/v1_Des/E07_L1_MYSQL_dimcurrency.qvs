//---------------------------------------

SET vS.TableName 	= Dim_Currency;
SET vS.QVDFileName 	= L1_MYSQL_DIM_Currency;
SET vS.PathFile 	= $(vQVDExtVtas);  

//---------------------------------------

$(vS.TableName):
    LOAD 
        CurrencyKey, 
        CurrencyLabel, 
        CurrencyName, 
        CurrencyDescription, 
        ETLLoadID, 
        LoadDate, 
        UpdateDate;
    SELECT
        *
    FROM spanish.dimcurrency;

STORE $(vS.TableName) INTO [$(vS.PathFile)/$(vS.QVDFileName).qvd] (qvd);
DROP TABLE $(vS.TableName);