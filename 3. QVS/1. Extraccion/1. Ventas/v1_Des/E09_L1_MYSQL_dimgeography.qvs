//---------------------------------------

SET vS.TableName 	= Dim_Geography;
SET vS.QVDFileName 	= L1_MYSQL_DIM_Geography;
SET vS.PathFile 	= $(vQVDExtVtas);  

//---------------------------------------

$(vS.TableName):
    LOAD 
        GeographyKey,
        GeographyTypeKey, 
        GeographyType, 
        ContinentName, 
        CityName, 
        StateProvinceName, 
        RegionCountryName, 
        Geometry, 
        ETLLoadID, 
        LoadDate, 
        UpdateDate;

    SELECT 
    *
    FROM spanish.dimgeography;

STORE $(vS.TableName) INTO [$(vS.PathFile)/$(vS.QVDFileName).qvd] (qvd);
DROP TABLE $(vS.TableName);