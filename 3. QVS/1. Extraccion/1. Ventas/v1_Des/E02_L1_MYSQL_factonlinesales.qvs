//---------------------------------------

SET vS.TableName 	= Tra_Online_Sales;
SET vS.QVDFileName 	= L1_MYSQL_TRA_Online_Sales;
SET vS.PathFile 	= $(vQVDExtVtas);  

//---------------------------------------


$(vS.TableName):
    LOAD 
        OnlineSalesKey, 
        DateKey, 
        StoreKey, 
        ProductKey, 
        PromotionKey, 
        CurrencyKey, 
        CustomerKey, 
        SalesOrderLineNumber, 
        SalesQuantity, 
        SalesAmount, 
        ReturnQuantity, 
        ReturnAmount, 
        DiscountQuantity, 
        DiscountAmount, 
        TotalCost, 
        UnitCost, 
        UnitPrice, 
        SalesOrderNumber;
    SELECT 
    *
FROM spanish.factonlinesales;

STORE $(vS.TableName) INTO [$(vS.PathFile)/$(vS.QVDFileName).qvd] (qvd);
DROP TABLE $(vS.TableName);