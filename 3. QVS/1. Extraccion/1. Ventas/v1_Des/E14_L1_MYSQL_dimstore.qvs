//---------------------------------------

SET vS.TableName 	= Dim_Stores;
SET vS.QVDFileName 	= L1_MYSQL_DIM_Stores;
SET vS.PathFile 	= $(vQVDExtVtas);  

//---------------------------------------

$(vS.TableName):
    LOAD 
        StoreKey,
        GeographyKey, 
        StoreManager, 
        StoreType, 
        StoreName, 
        StoreDescription, 
        Status, 
        OpenDate, 
        CloseDate, 
        EntityKey, 
        ZipCode, 
        ZipCodeExtension, 
        StorePhone, 
        StoreFax, 
        AddressLine1, 
        AddressLine2, 
        CloseReason, 
        EmployeeCount, 
        SellingAreaSize, 
        LastRemodelDate, 
        GeoLocation, 
        Geometry, 
        ImageUrl;
    SELECT 
    *
    FROM spanish.dimstore;

STORE $(vS.TableName) INTO [$(vS.PathFile)/$(vS.QVDFileName).qvd] (qvd);
DROP TABLE $(vS.TableName);